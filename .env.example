# Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# WhatsApp Cloud API
WA_PHONE_NUMBER_ID=your_phone_number_id
WA_ACCESS_TOKEN=your_whatsapp_access_token
WA_VERIFY_TOKEN=your_webhook_verify_token

# Google Maps
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Main operating system API (tlv-transfers) — uses HMAC-SHA256 signing
# Issued by Ride Control admin team
SUPPLIER_API_BASE=https://ridecontrolapi.tlv-transfers.com/rest/default/supplier
SUPPLIER_API_KEY=your_64_char_hex_api_key
SUPPLIER_API_SECRET=your_api_secret

# Dispatcher escalation
MICHEL_PHONE=0526084230

# App integration (deep-link base, until real implementation)
APP_DEEPLINK_BASE=https://example.com/trip

# Public base URL of THIS dispatch server (used in WhatsApp approval links)
APPROVAL_BASE_URL=https://dispatch.tlv-transfers.com

# Long random secret for signing approval URLs. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
APPROVAL_LINK_SECRET=replace_with_random_32_byte_secret

# Database
DATABASE_URL=sqlite+aiosqlite:///./dispatch.db

# Dev flags
FAST_TIMEOUT_SECONDS=0
# Set to e.g. 30 to override 3-hour offer timeout during dev/testing
