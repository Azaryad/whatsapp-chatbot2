# Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# WhatsApp Cloud API
WA_PHONE_NUMBER_ID=your_phone_number_id
WA_ACCESS_TOKEN=your_whatsapp_access_token
WA_VERIFY_TOKEN=your_webhook_verify_token

# Google Maps
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Main operating system API (tlv-transfers)
SUPPLIER_API_BASE=https://ridecontrolapi.tlv-transfers.com/rest/default/supplier
SUPPLIER_API_TOKEN=your_supplier_api_token

# Dispatcher escalation
MICHEL_PHONE=0526084230

# App integration (deep-link base, until real implementation)
APP_DEEPLINK_BASE=https://example.com/trip

# Database
DATABASE_URL=sqlite+aiosqlite:///./dispatch.db

# Dev flags
FAST_TIMEOUT_SECONDS=0
# Set to e.g. 30 to override 3-hour offer timeout during dev/testing
